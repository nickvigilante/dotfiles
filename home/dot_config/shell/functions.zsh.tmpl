# Shell utility functions — cross-platform.

# Create a directory and cd into it immediately.
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Search running processes.
psg() {
    ps aux | grep -i "$1" | grep -v grep
}

# Extract archives — auto-detects format.
extract() {
    if [[ ! -f "$1" ]]; then
        echo "'$1' is not a valid file"
        return 1
    fi
    case "$1" in
        *.tar.bz2)  tar xjf "$1"        ;;
        *.tar.gz)   tar xzf "$1"        ;;
        *.tar.xz)   tar xJf "$1"        ;;
        *.tar.zst)  tar --zstd -xf "$1" ;;
        *.bz2)      bunzip2 "$1"        ;;
        *.gz)       gunzip "$1"         ;;
        *.tar)      tar xf "$1"         ;;
        *.tbz2)     tar xjf "$1"        ;;
        *.tgz)      tar xzf "$1"        ;;
        *.zip)      unzip "$1"          ;;
        *.Z)        uncompress "$1"     ;;
        *.7z)       7z x "$1"           ;;
        *.rar)      unrar x "$1"        ;;
        *)          echo "'$1' cannot be extracted by extract()" ;;
    esac
}

# Print PATH entries one per line.
path() {
    echo "$PATH" | tr ':' '\n'
}

# Start a quick HTTP server in the current directory.
serve() {
    local port="${1:-8000}"
    echo "Serving at http://localhost:$port"
    python3 -m http.server "$port"
}

# Find files by name (case-insensitive).
ff() {
    find . -iname "*$1*" 2>/dev/null
}

# Show disk usage of top-level items, sorted by size.
dusage() {
    du -sh ./* 2>/dev/null | sort -h
}

# Jump to a git repo root.
groot() {
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Not in a git repo."; return 1; }
    cd "$root"
}

# Quickly create and activate a uv venv in the current directory.
venv-here() {
    uv venv .venv
    source .venv/bin/activate
}

# ── Secrets ───────────────────────────────────────────────────────────────────

{{ if or (eq .secrets "bitwarden") (eq .secrets "both") -}}
# _bw_ensure_session: bring the vault to an unlocked state, prompting via gum.
# Writes BW_SESSION to the caller's environment on success; returns 1 when the
# user declines or gives up.  Retries on bad password until the user says no.
# Never calls `chezmoi apply`.
_bw_ensure_session() {
    if ! command -v bw &>/dev/null; then
        echo "bw not found — install: brew install bitwarden-cli" >&2
        return 1
    fi
    local _state _session
    _state="$(bw status 2>/dev/null | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')"
    [[ "$_state" == "unlocked" ]] && return 0

    # Ask once before the first attempt.
    case "$_state" in
        locked)
            if command -v gum &>/dev/null; then
                gum confirm "Bitwarden vault is locked. Unlock now?" || return 1
            fi
            ;;
        *)
            # unauthenticated — bw unlock would just fail; must log in first
            if command -v gum &>/dev/null; then
                gum confirm --default=false "Bitwarden: not logged in. Log in now?" || return 1
            fi
            ;;
    esac

    # Attempt loop: retry on failure until the user declines.
    while true; do
        _state="$(bw status 2>/dev/null | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')"
        case "$_state" in
            unlocked)
                return 0
                ;;
            locked)
                if _session="$(bw unlock --raw)"; then
                    BW_SESSION="$_session"
                    export BW_SESSION
                    return 0
                fi
                ;;
            *)
                if _session="$(bw login --raw)"; then
                    BW_SESSION="$_session"
                    export BW_SESSION
                    return 0
                fi
                ;;
        esac

        # Attempt failed — offer retry; no means skip secrets.
        if command -v gum &>/dev/null; then
            gum confirm "Authentication failed. Try again?" --default=false || return 1
        else
            return 1
        fi
    done
}

# Wrap `chezmoi apply` to prompt for Bitwarden state before applying.
# Supports --skip-secrets to bypass prompts and apply without vault access.
# If the user declines to unlock/log-in, applies with secrets=none so
# vault-gated files (e.g. ~/.kube/homelab.yaml) are skipped rather than
# causing a hard failure.  All other chezmoi subcommands pass through unchanged.
chezmoi() {
    if [[ "${1}" != "apply" ]]; then
        command chezmoi "$@"
        return
    fi

    # Strip --skip-secrets (our extension) from the args before forwarding.
    local _skip=false _passthrough=()
    for _arg in "${@:2}"; do
        if [[ "$_arg" == "--skip-secrets" ]]; then
            _skip=true
        else
            _passthrough+=("$_arg")
        fi
    done

    if [[ "$_skip" == false ]]; then
        local _state
        _state="$(bw status 2>/dev/null | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')"
        if [[ "$_state" != "unlocked" ]]; then
            _bw_ensure_session || _skip=true
        fi
    fi

    if [[ "$_skip" == true ]]; then
        echo "Applying without Bitwarden — vault-dependent files will not be updated."
        command chezmoi apply --data secrets=none "${_passthrough[@]}"
    else
        command chezmoi apply "${_passthrough[@]}"
    fi
}

# Explicitly unlock/log-in, then apply.  Useful when you know you want secrets.
bw-apply() {
    _bw_ensure_session || return 1
    command chezmoi apply
}
{{- else }}
bw-apply() {
    echo "Bitwarden not configured for this machine (.secrets = {{ .secrets }})."
    chezmoi apply
}
{{- end }}

bw-lock() {
{{- if or (eq .secrets "bitwarden") (eq .secrets "both") }}
    bw lock
    unset BW_SESSION
{{- else }}
    echo "Bitwarden not configured for this machine (.secrets = {{ .secrets }})."
{{- end }}
}
