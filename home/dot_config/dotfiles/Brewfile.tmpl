# Unified Brewfile — rendered to ~/.config/dotfiles/Brewfile by chezmoi.
# Source: home/dot_config/dotfiles/Brewfile.tmpl
# Edit this template; run `chezmoi apply` to regenerate.

# ── Taps ─────────────────────────────────────────────────────────────────────
tap "coder/coder"

# ── Cross-platform CLI (every full-toolkit machine) ──────────────────────────
{{ range .packages -}}
{{ if and (eq .section "cli") .brew -}}
{{ printf "%-21s# %s" (printf "brew %q" .brew) .comment }}
{{ end -}}
{{ end }}
# ── Container runtime (skip inside Coder workspaces — they already run in one) ──
{{ range .packages -}}
{{ if and (eq .section "container-runtime") .brew (or (not (index . "machine")) (has $.machine (index . "machine"))) -}}
{{ if index . "comment" }}{{ printf "%-21s# %s" (printf "brew %q" .brew) (index . "comment") }}{{ else }}{{ printf "brew %q" .brew }}{{ end }}
{{ end -}}
{{ end }}

# ── Repo quality gate ────────────────────────────────────────────────────────
{{ range .packages -}}
{{ if and (eq .section "quality") .brew -}}
{{ printf "%-21s# %s" (printf "brew %q" .brew) .comment }}
{{ end -}}
{{ end }}

# ── macOS-only formulae ──────────────────────────────────────────────────────
{{ range .packages -}}
{{ if and (eq .section "macos-only") .brew (or (not (index . "os")) (has $.chezmoi.os (index . "os"))) -}}
{{ if index . "comment" }}{{ printf "%-21s# %s" (printf "brew %q" .brew) (index . "comment") }}{{ else }}{{ printf "brew %q" .brew }}{{ end }}
{{ end -}}
{{ end }}
# ── Secrets CLIs ─────────────────────────────────────────────────────────────
{{ range .packages -}}
{{ if and (eq .section "secrets") (or (not (index . "secrets")) (has $.secrets (index . "secrets"))) -}}
{{ if and (index . "cask") (eq $.chezmoi.os "darwin") -}}
{{ if index . "comment" }}{{ printf "%-21s# %s" (printf "cask %q" .cask) (index . "comment") }}{{ else }}{{ printf "cask %q" .cask }}{{ end }}
{{ else if .brew -}}
{{ if index . "comment" }}{{ printf "%-21s# %s" (printf "brew %q" .brew) (index . "comment") }}{{ else }}{{ printf "brew %q" .brew }}{{ end }}
{{ end }}
{{ end -}}
{{ end }}
# ── Work-only formulae ───────────────────────────────────────────────────────
{{ range .packages -}}
{{ if and (eq .section "work") .brew (or (not (index . "profiles")) (has $.profile (index . "profiles"))) -}}
{{ if index . "comment" }}{{ printf "%-21s# %s" (printf "brew %q" .brew) (index . "comment") }}{{ else }}{{ printf "brew %q" .brew }}{{ end }}
{{ end -}}
{{ end }}
# ── Personal-only formulae ───────────────────────────────────────────────────
{{ range .packages -}}
{{ if and (eq .section "personal") .brew (or (not (index . "profiles")) (has $.profile (index . "profiles"))) -}}
{{ if index . "comment" }}{{ printf "%-21s# %s" (printf "brew %q" .brew) (index . "comment") }}{{ else }}{{ printf "brew %q" .brew }}{{ end }}
{{ end -}}
{{ end }}
# Windows (separate setup): add `winget "RedHat.Podman"` gated to `.chezmoi.os "windows"`.

# ── GUI casks (macOS + display only — Linux Homebrew has no casks) ──────────
{{ if and .display (eq .chezmoi.os "darwin") -}}
{{ range .packages -}}
{{ if and (eq .section "cask") .cask (or (not (index . "profiles")) (has $.profile (index . "profiles"))) -}}
{{ if index . "comment" }}{{ printf "%-21s# %s" (printf "cask %q" .cask) (index . "comment") }}{{ else }}{{ printf "cask %q" .cask }}{{ end }}
{{ end -}}
{{ end }}
# ── VS Code extensions (only renders when display + macOS) ──────────────────
{{ range .packages -}}
{{ if and (eq .section "vscode") .vscode (or (not (index . "profiles")) (has $.profile (index . "profiles"))) -}}
{{ if index . "comment" }}{{ printf "%-21s# %s" (printf "vscode %q" .vscode) (index . "comment") }}{{ else }}{{ printf "vscode %q" .vscode }}{{ end }}
{{ end -}}
{{ end }}
# Mac App Store apps (Keynote, Pages, Xcode, etc.) are NOT installed via mas —
# the mas-cli has been broken on macOS Sonoma+ since Apple removed the private
# APIs it relied on. Install those manually from the App Store; see README.md
# for the curated list of MAS apps used on this setup.
{{- end }}

# ── Linux GUI apps (Flatpak; display + Linux) ───────────────────────────────
# Homebrew has no casks on Linux, so GUI apps come from Flathub via brew bundle's
# native `flatpak` type. Mirrors the personal macOS casks above. Requires the
# `flathub` remote (added by the Linux desktop bootstrap).
{{ if and .display (eq .chezmoi.os "linux") -}}
{{ range .packages -}}
{{ if and (eq .section "flatpak") .flatpak (or (not (index . "profiles")) (has $.profile (index . "profiles"))) -}}
{{ if index . "comment" }}{{ printf "%-45s# %s" (printf "flatpak %q" .flatpak) (index . "comment") }}{{ else }}{{ printf "flatpak %q" .flatpak }}{{ end }}
{{ end -}}
{{ end -}}
{{ end }}

# ── Cargo crates (personal: primary Rust dev) ────────────────────────────────
# These compile from source via cargo, so we only install on machines that
# actually do Rust development. Add ad-hoc with `brew install cargo-edit`
# (etc.) if you need them on the off-profile machine occasionally.
{{ range .packages -}}
{{ if and (eq .section "cargo") .cargo (or (not (index . "profiles")) (has $.profile (index . "profiles"))) -}}
{{ if index . "comment" }}{{ printf "%-29s# %s" (printf "cargo %q" .cargo) (index . "comment") }}{{ else }}{{ printf "cargo %q" .cargo }}{{ end }}
{{ end -}}
{{ end }}
# ── Go tools (work: primary Go dev) ──────────────────────────────────────────
{{ range .packages -}}
{{ if and (eq .section "go-tool") .go (or (not (index . "profiles")) (has $.profile (index . "profiles"))) -}}
{{ if index . "comment" }}{{ printf "%-21s# %s" (printf "go %q" .go) (index . "comment") }}{{ else }}{{ printf "go %q" .go }}{{ end }}
{{ end -}}
{{ end }}
# ── uv-installed Python tools ────────────────────────────────────────────────
{{ range .packages -}}
{{ if and (eq .section "uv") .uv (or (not (index . "profiles")) (has $.profile (index . "profiles"))) -}}
{{ if index . "comment" }}{{ printf "%-21s# %s" (printf "uv %q" .uv) (index . "comment") }}{{ else }}{{ printf "uv %q" .uv }}{{ end }}
{{ end -}}
{{ end }}
# ── npm global tools ─────────────────────────────────────────────────────────
{{ range .packages -}}
{{ if and (eq .section "npm") .npm (or (not (index . "profiles")) (has $.profile (index . "profiles"))) -}}
{{ if index . "comment" }}{{ printf "%-39s# %s" (printf "npm %q" .npm) (index . "comment") }}{{ else }}{{ printf "npm %q" .npm }}{{ end }}
{{ end -}}
{{ end }}
