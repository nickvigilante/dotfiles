# Mac App Store apps (Keynote, Pages, Xcode, etc.) are NOT installed via mas —
# the mas-cli has been broken on macOS Sonoma+ since Apple removed the private
# APIs it relied on. Install those manually from the App Store; see README.md
# for the curated list of MAS apps used on this setup.
{{- end }}

# ── Linux GUI apps (Flatpak; display + Linux) ───────────────────────────────
# Homebrew has no casks on Linux, so GUI apps come from Flathub via brew bundle's
# native `flatpak` type. Mirrors the personal macOS casks above. Requires the
# `flathub` remote (added by the Linux desktop bootstrap).
{{ if and .display (eq .chezmoi.os "linux") (eq .profile "personal") -}}
flatpak "com.bitwarden.desktop"             # Bitwarden password manager (GUI)
flatpak "com.discordapp.Discord"            # Discord
flatpak "net.cozic.joplin_desktop"          # Joplin notes
flatpak "org.videolan.VLC"                  # VLC media player
flatpak "org.keepassxc.KeePassXC"           # KeePassXC
flatpak "org.kde.okular"                    # Okular document viewer
flatpak "org.chromium.Chromium"             # Chromium
flatpak "com.valvesoftware.Steam"           # Steam
flatpak "com.orcaslicer.OrcaSlicer"        # OrcaSlicer 3D printing slicer
flatpak "com.rustdesk.RustDesk"            # RustDesk remote desktop (mirrors macOS cask)
flatpak "org.gnome.Extensions"             # GNOME Extensions manager
flatpak "org.gnome.gitlab.somas.Apostrophe" # Apostrophe Markdown editor
flatpak "org.libreoffice.LibreOffice"      # LibreOffice office suite (mirrors macOS cask)
flatpak "com.github.flxzt.rnote"           # Rnote handwriting / stylus notes app
{{- end }}

# ── Cargo crates (personal: primary Rust dev) ────────────────────────────────
# These compile from source via cargo, so we only install on machines that
# actually do Rust development. Add ad-hoc with `brew install cargo-edit`
# (etc.) if you need them on the off-profile machine occasionally.
{{ if eq .profile "personal" -}}
cargo "cargo-edit"          # `cargo upgrade` to bump dep versions
cargo "bws"                 # Bitwarden Secrets Manager CLI (no Homebrew formula); used by the infrastructure repo's coder/tofu.sh
cargo "cargo-audit"         # Checks Cargo.lock against the RustSec advisory database
{{- end }}

# ── Go tools (work: primary Go dev) ──────────────────────────────────────────
{{ if eq .profile "work" -}}
go "github.com/golangci/golangci-lint/cmd/golangci-lint"
{{- end }}

# ── uv-installed Python tools ────────────────────────────────────────────────
uv "headroom-ai"        # Claude Code context-compression tool (provides `headroom`)
{{ if eq .profile "personal" -}}
uv "weasyprint"
{{- end }}

# ── npm global tools ─────────────────────────────────────────────────────────
npm "@earendil-works/pi-coding-agent"   # pi coding agent CLI
