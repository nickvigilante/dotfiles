# Unified Brewfile — rendered to ~/.config/dotfiles/Brewfile by chezmoi.
# Source: home/dot_config/dotfiles/Brewfile.tmpl
# Edit this template; run `chezmoi apply` to regenerate.

# ── Taps ─────────────────────────────────────────────────────────────────────
tap "coder/coder"

# ── Cross-platform CLI (every full-toolkit machine) ──────────────────────────
brew "git"           # Distributed revision control
brew "curl"          # HTTP client
brew "wget"          # File retriever
brew "jq"            # JSON processor
brew "ripgrep"       # Fast grep (rg)
brew "fd"            # Fast find
brew "fzf"           # Fuzzy finder
brew "eza"           # Better ls
brew "bat"           # Better cat (syntax highlighting)
brew "zoxide"        # Better cd
brew "tldr"          # Simplified man pages
brew "htop"          # Process viewer
brew "tree"          # Directory tree
brew "tmux"          # Terminal multiplexer
brew "neovim"        # Editor
brew "gh"            # GitHub CLI
brew "rtk"           # LLM token-saving CLI proxy (Claude Code Bash hook)
brew "git-delta"     # Better git diff
brew "lazygit"       # TUI git client
brew "ncdu"          # NCurses Disk Usage
brew "uv"            # Python package manager (Astral)
brew "ruff"          # Python linter (Astral)
brew "gnupg"         # OpenPGP
brew "age"           # Modern encryption
brew "chezmoi"       # Dotfiles manager
brew "gum"           # Charm shell UI
brew "just"          # Command runner / project Makefile alternative
brew "mprocs"        # Run multiple commands in parallel
brew "rustup"        # Rust toolchain manager (replaces brew rust; needed for wasm32 target)
brew "node"          # Node.js
brew "prettier"      # Code formatter
brew "starship"      # Cross-shell prompt (initialized in completions.zsh)
brew "dust"          # du replacement: visual disk usage tree
brew "duf"           # df replacement: color-coded disk free
brew "bottom"        # htop alt: graphs over time, mouse, layouts (binary: btm)
brew "hyperfine"     # CLI benchmarking tool
brew "glow"          # Markdown renderer for the terminal
brew "sd"            # sed replacement: PCRE syntax, no GNU/BSD -i divergence
brew "make"          # GNU make (macOS ships 3.81; use as `make` via libexec/gnubin)
brew "gnu-getopt"    # GNU getopt with long-option support (keg-only)
brew "yq"            # YAML/JSON/XML processor (the "jq for YAML")
brew "nmap"          # Network/port scanner
brew "f3"            # Flash-media fake-capacity tester (f3probe/f3write/f3read)
brew "cmake"         # C/C++ build-system generator
brew "coder/coder/coder" # Coder.com CLI — remote dev, manages the homelab deployment/templates

# Repo quality gate (CI + pre-commit) — see docs/superpowers/plans/2026-06-22-repo-housekeeping-ci.md
brew "actionlint"        # GitHub Actions workflow linter
brew "markdownlint-cli2" # Markdown linter
brew "pre-commit"        # Git hook framework
brew "shellcheck"        # Shell script static analysis
brew "shfmt"             # Shell script formatter
brew "taplo"             # TOML toolkit (formatter + linter)
brew "yamllint"          # YAML linter

# ── macOS-only formulae ──────────────────────────────────────────────────────
{{ if eq .chezmoi.os "darwin" -}}
brew "mas"           # Mac App Store CLI
brew "duti"          # Default-app picker
brew "grep"          # GNU grep (better than BSD)
brew "gnupg"         # (already above; macOS sometimes needs explicit)
{{- end }}

# ── Secrets CLIs ─────────────────────────────────────────────────────────────
{{ if or (eq .secrets "bitwarden") (eq .secrets "both") -}}
brew "bitwarden-cli"    # bw CLI — one cross-platform binary (replaces the Linux snap)
{{- end }}
{{ if or (eq .secrets "1password") (eq .secrets "both") -}}
    {{- if eq .chezmoi.os "darwin" }}
cask "1password-cli"
    {{- else }}
brew "1password-cli"
    {{- end }}
{{- end }}

# ── Work-only formulae ───────────────────────────────────────────────────────
{{ if eq .profile "work" -}}
brew "go"               # Go language (work-only; personal pushes Go dev to Coder workspaces)
brew "vale"             # Prose linter
brew "halibut"          # Document preparation
brew "gopls"            # Go language server
brew "colima"           # Container runtime (macOS/Linux)
brew "docker"           # Docker CLI
brew "snap"             # snap CLI on macOS (.snap files)
{{- end }}

# ── Personal-only formulae ───────────────────────────────────────────────────
{{ if eq .profile "personal" -}}
brew "fish"          # Friendly shell (alternative)
brew "podman"        # Container runtime (replaces Docker; rootless/daemonless)
brew "opentofu"      # OpenTofu — the infrastructure repo's contexts (homelab, cloudflare, coder)
brew "kubernetes-cli" # kubectl — reach the homelab cluster and run the MCP break-glass port-forwards
brew "wasm-pack"     # Rust->WASM packager (typhony demo site build)
brew "openapi-generator"
brew "pandoc"        # Markup converter
brew "weasyprint"    # HTML → PDF
{{- end }}
# Windows (separate setup): add `winget "RedHat.Podman"` gated to `.chezmoi.os "windows"`.

# ── GUI casks (macOS + display only — Linux Homebrew has no casks) ──────────
