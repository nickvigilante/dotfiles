# Cross-profile casks (always installed when display + macOS)
cask "warp"
cask "ghostty"
cask "visual-studio-code"
cask "logi-options+"
cask "displaylink"
cask "keepingyouawake"
cask "rustdesk"

# Fonts
cask "font-jetbrains-mono-nerd-font"
cask "font-fira-code-nerd-font"
cask "font-0xproto-nerd-font"

  {{ if eq .profile "work" -}}
# Work-only casks
cask "claude"             # Anthropic Claude desktop
cask "docker-desktop"
cask "zoom"
  {{- end }}

  {{ if eq .profile "personal" -}}
# Personal-only casks
cask "firefox"
cask "orion"              # WebKit browser
cask "bitwarden"          # Password manager GUI
cask "discord"
cask "dolphin"            # GameCube/Wii emulator
cask "freetube"           # YouTube client
cask "joplin"             # Note-taking
cask "libreoffice"
cask "proton-drive"
cask "proton-mail"
cask "protonvpn"
cask "raindropio"         # Bookmark manager
cask "signal"
cask "steam"
cask "texmaker"           # LaTeX
cask "todoist-app"
cask "vlc"
  {{- end }}

