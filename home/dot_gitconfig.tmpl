[user]
    name  = {{ .name }}
    email = {{ .email }}

[core]
    excludesfile = ~/.gitignore_global
    # Normalize line endings: convert CRLF→LF on commit on Windows; leave alone elsewhere
    autocrlf     = {{ if eq .chezmoi.os "windows" }}true{{ else }}input{{ end }}
    editor       = vim
    pager        = delta

[init]
    defaultBranch = main
    # Seeds every `git init`/`git clone` with the hooks in
    # ~/.config/git/template/hooks (source: home/dot_config/git/template/hooks
    # in this repo). Those hooks auto-run `pre-commit` when a repo has a
    # .pre-commit-config.yaml, so local enforcement works without a per-repo
    # `pre-commit install` step. Only applies to NEW git init/clone -- an
    # existing local checkout needs `git init` re-run once (safe, idempotent,
    # git only adds hooks that aren't already there) to pick it up.
    templateDir = ~/.config/git/template

[pull]
    rebase = false

[push]
    autoSetupRemote = true

# What `gh auth setup-git` writes: git authenticates to GitHub through the gh
# login, so HTTPS pushes work without a separate credential store. The empty
# `helper =` line clears any helper inherited from the system config.
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential

[fetch]
    prune = true

[diff]
    colorMoved = default

[merge]
    conflictstyle = zdiff3

[alias]
    st   = status
    co   = checkout
    br   = branch
    lg   = log --oneline --graph --decorate --all
    undo = reset HEAD~1 --mixed
    wip  = "!git add -A && git commit -m 'WIP'"

[color]
    ui = auto

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection

