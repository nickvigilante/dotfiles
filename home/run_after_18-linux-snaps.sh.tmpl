#!/usr/bin/env bash
# run_after_18-linux-snaps: install snaps on any Linux machine where snapd is
# actually running — desktops, headless servers, and 64-bit Pis alike.
#   os/linux/packages-cli.snap  every machine with a running snapd
#   os/linux/packages.snap      GUI apps; only non-Pi machines with a display
# Stamp-and-compare on the manifests that apply here, like the desktop-apt
# block in run_after_install-packages. Best-effort: a failed install warns and
# leaves the stamp unwritten so it retries next apply.
set -uo pipefail

{{ if eq .chezmoi.os "linux" -}}
command -v snap >/dev/null || exit 0
# Containers (Coder, Docker) can ship the snap client with no daemon behind
# it, since snapd needs systemd as PID 1. Probe the daemon's socket, not just
# the client, or every install below fails with "cannot communicate with server".
[ -S /run/snapd.socket ] || exit 0

REPO_DIR="{{ .chezmoi.sourceDir }}/.."
CANDIDATES=("$REPO_DIR/os/linux/packages-cli.snap")
{{ if and (ne .machine "pi") .display -}}
CANDIDATES+=("$REPO_DIR/os/linux/packages.snap")
{{ end -}}
PKG_FILES=()
for f in "${CANDIDATES[@]}"; do
    [ -f "$f" ] && PKG_FILES+=("$f")
done
[ "${#PKG_FILES[@]}" -gt 0 ] || exit 0

STAMP_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
STAMP_FILE="$STAMP_DIR/linux-snap-packages.stamp"
mkdir -p "$STAMP_DIR"

current_hash="$(cat "${PKG_FILES[@]}" | sha256sum | awk '{print $1}')"
last_hash="$(cat "$STAMP_FILE" 2>/dev/null || echo "")"
[ "$current_hash" = "$last_hash" ] && exit 0

echo "==> Snap manifests changed — syncing..."
ok=1
while read -r pkg; do
    snap list "$pkg" &>/dev/null && continue
    # On apt-based distros, skip packages already installed via dpkg
    # (e.g. signal-desktop from the Signal apt repo on Ubuntu/Debian).
    if command -v dpkg-query >/dev/null 2>&1 \
        && dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then
        echo "==> $pkg already installed via dpkg, skipping snap"
        continue
    fi
    sudo snap install "$pkg" || { echo "WARN: snap install $pkg failed" >&2; ok=0; }
done < <(grep -hEv '^#|^$' "${PKG_FILES[@]}")

[ "$ok" = 1 ] && echo "$current_hash" > "$STAMP_FILE"
{{- end }}
