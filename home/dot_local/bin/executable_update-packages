#!/usr/bin/env bash
# update-packages: install updates across all package managers.
# Runs only when asked (`update-packages` or `dotfiles update`) — never from a
# shell startup file, so it cannot race `chezmoi apply`. On success it writes
# the stamp ~/.zshrc reads to nudge when updates are overdue.

set -euo pipefail

STAMP_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/last_update"
LOCK_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/brew.lock"
FAILED=0

mkdir -p "$(dirname "$STAMP_FILE")"

echo ""
echo "┌─────────────────────────────────────────────┐"
echo "│  Running package updates...                 │"
echo "└─────────────────────────────────────────────┘"
echo ""

# ── Detect platform ────────────────────────────────────────────────────────────
OS="unknown"
DISTRO=""
case "$(uname -s)" in
	Darwin) OS="macos" ;;
	Linux)
		OS="linux"
		if [[ -f /etc/os-release ]]; then
			DISTRO=$(. /etc/os-release && echo "$ID")
		fi
		;;
	CYGWIN* | MINGW* | MSYS*) OS="windows" ;;
esac

# ── Updater functions ──────────────────────────────────────────────────────────
# The command runs without fd 9, the brew lock: a process it starts can outlive
# this script and would otherwise hold the lock until it exits.
run_update() {
	local label="$1"
	shift
	echo "→ $label..."
	if "$@" 9>&-; then
		echo "  ✓ $label done."
	else
		echo "  ✗ $label failed (non-fatal)."
		FAILED=1
	fi
}

# Hold the lock shared with `chezmoi apply` and `bup` for the whole brew
# sequence: an upgrade that overlaps `brew bundle` can leave casks with broken
# Caskroom metadata and kegs unlinked. Fd 9 closes with the subshell, which
# releases the lock. Without flock (before the Brewfile installs it) run unlocked.
update_brew() {
	command -v brew &> /dev/null || return 0
	(
		if command -v flock &> /dev/null; then
			exec 9> "$LOCK_FILE"
			if ! flock -w 300 9; then
				echo "  ✗ Homebrew skipped: another brew job held the lock for 5 minutes."
				exit 1
			fi
		fi
		run_update "Homebrew" brew update
		run_update "Homebrew upgrade" brew upgrade
		run_update "Homebrew cleanup" brew cleanup
		exit "$FAILED"
	) || FAILED=1
}

update_apt() {
	command -v apt &> /dev/null || return 0
	run_update "apt" sudo apt update
	run_update "apt upgrade" sudo apt upgrade -y
	run_update "apt autoremove" sudo apt autoremove -y
}

update_dnf() {
	command -v dnf &> /dev/null || return 0
	run_update "dnf upgrade" sudo dnf upgrade -y
}

update_snap() {
	command -v snap &> /dev/null || return 0
	# The client can exist without a running daemon (containers).
	[[ -S /run/snapd.socket ]] || return 0
	run_update "snap" sudo snap refresh
}

update_choco() {
	command -v choco &> /dev/null || return 0
	run_update "Chocolatey" choco upgrade all -y
}

update_chezmoi() {
	command -v chezmoi &> /dev/null || return 0
	run_update "chezmoi" chezmoi upgrade
}

# ── Run updates for this platform ─────────────────────────────────────────────
case "$OS" in
	macos)
		update_brew
		update_chezmoi
		;;
	linux)
		case "$DISTRO" in
			ubuntu | debian) update_apt ;;
			raspbian) update_apt ;;
			fedora | rhel | centos) update_dnf ;;
		esac
		update_brew
		update_snap
		update_chezmoi
		;;
	windows)
		update_choco
		update_chezmoi
		;;
esac

echo ""
if ((FAILED)); then
	echo "✗ Some updates failed; not recording this run: $(date)"
	exit 1
fi
date +%s > "$STAMP_FILE"
echo "✓ All updates complete: $(date)"
echo ""
