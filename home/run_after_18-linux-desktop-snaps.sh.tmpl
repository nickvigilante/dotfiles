#!/usr/bin/env bash
# run_after_18-linux-desktop-snaps: install the snap apps whose only official
# Linux channel is the Snap Store (raindrop, todoist). Stamp-and-compare on
# os/linux/packages.snap, like the desktop-apt block in run_after_install-packages.
# Gated linux + display + non-pi. Best-effort: a failed install warns and leaves
# the stamp unwritten so it retries next apply.
set -uo pipefail

{{ if and (eq .chezmoi.os "linux") (ne .machine "pi") .display -}}
command -v snap >/dev/null || exit 0

REPO_DIR="{{ .chezmoi.sourceDir }}/.."
PKG_FILE="$REPO_DIR/os/linux/packages.snap"
STAMP_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
STAMP_FILE="$STAMP_DIR/linux-snap-packages.stamp"

[ -f "$PKG_FILE" ] || exit 0
mkdir -p "$STAMP_DIR"

current_hash="$(sha256sum "$PKG_FILE" | awk '{print $1}')"
last_hash="$(cat "$STAMP_FILE" 2>/dev/null || echo "")"
[ "$current_hash" = "$last_hash" ] && exit 0

echo "==> Snap apps changed — syncing..."
ok=1
while read -r pkg; do
    snap list "$pkg" &>/dev/null && continue
    # On apt-based distros, skip packages already installed via dpkg
    # (e.g. signal-desktop from the Signal apt repo on Ubuntu/Debian).
    if command -v dpkg-query >/dev/null 2>&1 \
        && dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then
        echo "==> $pkg already installed via dpkg, skipping snap"
        continue
    fi
    sudo snap install "$pkg" || { echo "WARN: snap install $pkg failed" >&2; ok=0; }
done < <(grep -Ev '^#|^$' "$PKG_FILE")

[ "$ok" = 1 ] && echo "$current_hash" > "$STAMP_FILE"
{{- end }}
