{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
{{- range $base, $spec := .permissions.commands }}
    {{- $heads := list }}
    {{- if not (hasKey $spec "rtk_only") }}{{ $heads = append $heads $base }}{{ end }}
    {{- if has $base $.permissions.rtk_wraps }}{{ $heads = append $heads (printf "rtk %s" $base) }}{{ end }}
    {{- if hasKey $spec "extra_heads" }}{{ range $eh := $spec.extra_heads }}{{ $heads = append $heads $eh }}{{ end }}{{ end }}
    {{- range $head := $heads }}
        {{- range $arg := $spec.args }}
      "Bash({{ $head }}{{ if $arg }} {{ $arg }}{{ end }})",
        {{- end }}
    {{- end }}
{{- end }}
      "Bash(brew info *)",
      "Bash(brew search *)",
      "Bash(brew outdated)",
      "Bash(brew deps *)",
      "Bash(brew uses *)",
      "Bash(brew leaves)",
      "Bash(brew desc *)",
      "Bash(brew doctor)",
      "Bash(brew tap-info *)",
      "Bash(brew bundle check *)",
      "Bash(brew bundle list *)",
      "Bash(brew list)",
      "Bash(brew list *)",
      "Bash(brew tap)",
      "Bash(rustup show)",
      "Bash(rustup target list)",
      "Bash(rustup toolchain list)",
      "Bash(rustup component list *)",
      "Bash(rustup check)",
      "Bash(sw_vers)",
      "Bash(defaults read *)",
      "Bash(system_profiler *)",
      "Bash(mdls *)",
      "Bash(plutil -p *)",
      "Bash(diskutil info *)",
      "Bash(diskutil list)",
      "Bash(pkgutil --pkgs *)",
      "Bash(pkgutil --pkg-info *)",
      "Bash(xcode-select -p)",
      "Bash(launchctl list *)",
      "Bash(softwareupdate -l)",
      "Bash(duti -x *)",
      "Bash(duti -l *)",
      "Bash(shellcheck *)",
      "Bash(gitleaks version)",
      "Bash(gitleaks git *)",
      "Bash(ffmpeg -version)",
      "Bash(ffprobe *)",
      "Bash(cf-terraforming version)",
      "Bash(helm version*)",
      "Bash(helm env)",
      "Bash(helm list*)",
      "Bash(helm ls*)",
      "Bash(helm status *)",
      "Bash(helm history *)",
      "Bash(helm get hooks *)",
      "Bash(helm get notes *)",
      "Bash(helm get metadata *)",
      "Bash(helm repo list*)",
      "Bash(helm search *)",
      "Bash(helm dependency list *)",
      "Bash(helm lint *)",
      "Bash(helm template *)",
      "Bash(helm plugin list)",
      "Bash(rtk gain *)",
      "Bash(rtk discover)",
      "Bash(rtk cc-economics *)",
      "Bash(rtk session *)",
      "Bash(rtk config show)",
      "Bash(rtk --version)",
      "Bash(rtk --help)",
      "Bash(jq *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(tail *)",
      "Bash(date *)",
      "Bash(echo \"exit $?\")",
      "Bash(echo exit $?)",
      "Bash(echo $?)",
      "Bash(pwd)",
      "Bash(true)",
      "Bash(:)"
    ],
    "deny": [
{{- $first := true }}
{{- range $base, $spec := .permissions.commands }}
  {{- if hasKey $spec "deny_args" }}
    {{- $heads := list $base }}
    {{- if has $base $.permissions.rtk_wraps }}{{ $heads = append $heads (printf "rtk %s" $base) }}{{ end }}
    {{- if hasKey $spec "extra_heads" }}{{ range $eh := $spec.extra_heads }}{{ $heads = append $heads $eh }}{{ end }}{{ end }}
    {{- range $head := $heads }}
      {{- range $arg := $spec.deny_args }}
        {{- if not $first }},{{ end }}{{ $first = false }}
      "Bash({{ $head }} {{ $arg }})"
      {{- end }}
    {{- end }}
  {{- end }}
{{- end }}
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/permission-prefilter.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/claude-config-drift.sh\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$HOME/.claude/statusline.sh\""
  },
  "enabledPlugins": {
    "i-have-adhd@i-have-adhd": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": false,
    "warp@claude-code-warp": true,
    "frontend-design@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "context7@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "playground@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": false
  },
  "skillOverrides": {
    "notion-mcp-waf": "off"
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
