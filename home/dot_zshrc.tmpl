# ~/.zshrc — interactive shell configuration.
# Sourced for every interactive zsh session.

# ── Completions (must come before oh-my-zsh init) ─────────────────────────────
# Add user-installed completions to fpath so compinit picks them up.
fpath=("$HOME/.local/share/zsh/completions" $fpath)
# Homebrew ships completions (e.g. eza) to its site-functions dir.
# .zprofile sets this for login shells via `brew shellenv`, but adding it
# here ensures it's available in non-login interactive shells too.
command -v brew &>/dev/null && fpath=("$(brew --prefix)/share/zsh/site-functions" $fpath)

# ── Oh My ZSH ─────────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

# Update without prompting. chezmoi also manages OMZ via .chezmoiexternal.toml
# (weekly git pull), so OMZ's own updater is a secondary safety net.
DISABLE_UPDATE_PROMPT="true"
DISABLE_AUTO_UPDATE="false"
UPDATE_ZSH_DAYS=7

plugins=(
    git
    z
    zsh-autosuggestions
    zsh-syntax-highlighting
    {{- if eq .chezmoi.os "darwin" }}
    macos
    {{- end }}
    {{- if eq .profile "work" }}
    aws
    {{- end }}
)

source "$ZSH/oh-my-zsh.sh"

# ── Shell configuration fragments ─────────────────────────────────────────────
SHELL_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/shell"

source "$SHELL_CONFIG/exports.zsh"
source "$SHELL_CONFIG/aliases.zsh"
source "$SHELL_CONFIG/functions.zsh"

# Platform-specific aliases
{{- if eq .chezmoi.os "darwin" }}
source "$SHELL_CONFIG/aliases_macos.zsh"
{{- else if eq .chezmoi.os "linux" }}
source "$SHELL_CONFIG/aliases_linux.zsh"
{{- end }}

# macOS-specific environment
{{- if eq .chezmoi.os "darwin" }}
export DOCKER_HOST="unix://${HOME}/.config/colima/default/docker.sock"
{{- end }}

# Linux-specific environment
{{- if eq .chezmoi.os "linux" }}
# Homebrew's pkg-config searches only brew's own prefix, so crates that link
# system libraries (X11, etc.) can't find their .pc files. Prepend the system
# pkg-config dirs that actually exist so `cargo build` resolves them.
for _pcdir in "/usr/lib/$(uname -m)-linux-gnu/pkgconfig" /usr/lib/pkgconfig /usr/share/pkgconfig; do
    [[ -d $_pcdir ]] && PKG_CONFIG_PATH="${PKG_CONFIG_PATH:+$PKG_CONFIG_PATH:}$_pcdir"
done
export PKG_CONFIG_PATH
unset _pcdir
{{- end }}

# Profile-specific configuration
{{- if eq .profile "work" }}
source "$SHELL_CONFIG/work.zsh"
{{- else }}
source "$SHELL_CONFIG/personal.zsh"
{{- end }}

# ── Tool completions and shell initializations ────────────────────────────────
source "$SHELL_CONFIG/completions.zsh"

# ── Package update nudge ──────────────────────────────────────────────────────
# Updates only run when asked (`dotfiles update`); an unattended `brew upgrade`
# racing `chezmoi apply` is what left casks with broken metadata. This just
# reads the stamp update-packages writes on success and prints one line.
zmodload -F zsh/datetime p:EPOCHSECONDS
_update_stamp="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/last_update"
if [[ -r $_update_stamp && "$(<"$_update_stamp")" == <-> ]]; then
    _update_age=$(( (EPOCHSECONDS - $(<"$_update_stamp")) / 86400 ))
    (( _update_age >= 7 )) && print -P "%F{yellow}Packages last updated ${_update_age} days ago — run 'dotfiles update'%f"
    unset _update_age
else
    print -P "%F{yellow}Packages have never been updated here — run 'dotfiles update'%f"
fi
unset _update_stamp
{{ if eq .profile "personal" }}
# >>> requesty cli installer >>>
export PATH="{{ .chezmoi.homeDir }}/.requesty/bin:$PATH"
# <<< requesty cli installer <<<
{{- end }}

# ── Warp subshell detection ───────────────────────────────────────────────────
# Tells Warp this is a shell it can treat as first-class (blocks, completions,
# command history) when reached as a subshell -- `ssh main.kubernetes.nickv.coder`,
# `docker exec`, and so on. Without it Warp prompts once per session to Warpify.
#
# `coder ssh kubernetes` is deliberately NOT covered: Warp hooks the `ssh`
# command itself, and the coder CLI opens the connection internally, so there is
# nothing for Warp to recognise. Use the `coder config-ssh` host alias instead.
#
# Interactive sessions only. Emitting the escape sequence into a non-interactive
# session corrupts scp and rsync streams, which read stdout as data.
#
# Also gated on $TERM_PROGRAM: this fires on every interactive shell regardless
# of which client is attached. Warp sets TERM_PROGRAM=WarpTerminal itself (even
# over its own SSH wrapper), so other terminals reaching this host over SSH --
# e.g. Ghostty -- don't have it set. Without the gate, those terminals receive a
# DCS sequence only Warp knows how to consume, which corrupted terminal state
# and caused duplicated/garbled keystroke echo for the rest of the session.
[[ $- == *i* && "$TERM_PROGRAM" == "WarpTerminal" ]] && printf '\eP$f{"hook": "SourcedRcFileForWarp", "value": { "shell": "zsh" }}\x9c' || true
