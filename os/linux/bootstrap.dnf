# Pre-Homebrew prerequisites for Fedora.
# Installed by bootstrap/install.sh and as defense-in-depth by run_once_01.

curl
git
zsh
ca-certificates
@development-tools
file
procps-ng
gnupg2

# Desktop apps on Fedora (when a graphical Fedora machine is set up — there is
# no Fedora desktop package path yet, this is a breadcrumb):
#   ghostty  -> `dnf copr enable scottames/ghostty && dnf install ghostty`
#              (Ubuntu 26.04+ gets ghostty from the official archive instead)
